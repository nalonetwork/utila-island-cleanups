---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin Dashboard - Utila Island Cleanups" robots="noindex, nofollow" siteScript={false} ionicons={false}>
    <div class="admin-wrap">

        <section id="admin-login" class="login-card">
            <h1>Admin Login</h1>
            <form id="login-form">
                <div class="form-field">
                    <label for="login-email">Email</label>
                    <input type="email" id="login-email" required>
                </div>
                <div class="form-field">
                    <label for="login-password">Password</label>
                    <input type="password" id="login-password" required>
                </div>
                <button type="submit" class="btn">Sign In</button>
                <p id="login-error" class="error-text"></p>
            </form>
        </section>

        <div id="admin-dashboard" hidden>

            <header class="admin-header">
                <img src="/UICsquare.png" alt="Utila Island Cleanups" class="logo">
                <button id="logout-btn" class="btn">Log Out</button>
            </header>

            <section class="admin-section">
                <h2>Log New Cleanup</h2>
                <form id="cleanup-form">
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="cleanup-date">Date</label>
                            <input type="date" id="cleanup-date" required>
                        </div>
                        <div class="form-field">
                            <label for="cleanup-location">Location</label>
                            <input type="text" id="cleanup-location" required>
                        </div>
                        <div class="form-field">
                            <label for="cleanup-bags">Bags Collected</label>
                            <input type="number" id="cleanup-bags" min="0">
                        </div>
                        <div class="form-field">
                            <label for="cleanup-bottles">Bottles Recycled</label>
                            <input type="number" id="cleanup-bottles" min="0">
                        </div>
                        <div class="form-field">
                            <label for="cleanup-weight">Weight (kg)</label>
                            <input type="number" id="cleanup-weight" min="0" step="0.1">
                        </div>
                        <div class="form-field">
                            <label for="cleanup-volunteers">Volunteers</label>
                            <input type="number" id="cleanup-volunteers" min="0">
                        </div>
                        <div class="form-field">
                            <label for="cleanup-organizer">Lead Organizer</label>
                            <input type="text" id="cleanup-organizer">
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="cleanup-notes">Notes</label>
                        <textarea id="cleanup-notes" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn">Log Cleanup</button>
                    <p id="cleanup-form-status" class="form-status"></p>
                </form>
            </section>

            <section class="admin-section">
                <h2>Past Cleanups</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Bags</th>
                                <th>Bottles</th>
                                <th>Weight (kg)</th>
                                <th>Volunteers</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cleanups-table-body">
                            <tr><td colspan="7">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-section">
                <h2>Update Announcement</h2>
                <form id="announcement-form">
                    <input type="hidden" id="announcement-id">
                    <div class="checkbox-row">
                        <input type="checkbox" id="announcement-active">
                        <label for="announcement-active">Active (show on homepage)</label>
                    </div>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="announcement-title-en">Title (EN)</label>
                            <input type="text" id="announcement-title-en">
                        </div>
                        <div class="form-field">
                            <label for="announcement-title-es">Title (ES)</label>
                            <input type="text" id="announcement-title-es">
                        </div>
                        <div class="form-field">
                            <label for="announcement-title-fr">Title (FR)</label>
                            <input type="text" id="announcement-title-fr">
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="announcement-details-en">Details (EN)</label>
                        <textarea id="announcement-details-en" rows="2"></textarea>
                    </div>
                    <div class="form-field">
                        <label for="announcement-details-es">Details (ES)</label>
                        <textarea id="announcement-details-es" rows="2"></textarea>
                    </div>
                    <div class="form-field">
                        <label for="announcement-details-fr">Details (FR)</label>
                        <textarea id="announcement-details-fr" rows="2"></textarea>
                    </div>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="announcement-meetup-time">Meetup Time</label>
                            <input type="text" id="announcement-meetup-time" placeholder="e.g. Wednesday 7:00 AM">
                        </div>
                        <div class="form-field">
                            <label for="announcement-meeting-point">Meeting Point</label>
                            <input type="text" id="announcement-meeting-point" placeholder="e.g. Circle K">
                        </div>
                    </div>
                    <button type="submit" class="btn">Save Announcement</button>
                    <p id="announcement-status" class="form-status"></p>
                </form>
            </section>

            <section class="admin-section">
                <h2>Recent Volunteer Signups</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>WhatsApp</th>
                                <th>Language</th>
                                <th>Planned Date</th>
                                <th>Own Gloves</th>
                            </tr>
                        </thead>
                        <tbody id="signups-table-body">
                            <tr><td colspan="6">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

        </div>

    </div>

    <script>
        import '../scripts/admin.js';
    </script>
</Layout>
