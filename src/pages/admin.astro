---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin Dashboard - Utila Island Cleanups" robots="noindex, nofollow" siteScript={false} ionicons={false}>
    <div class="admin-wrap">

        <section id="admin-login" class="login-card">
            <h1>Admin Login</h1>
            <form id="login-form">
                <div class="form-field">
                    <label for="login-email">Email</label>
                    <input type="email" id="login-email" required>
                </div>
                <div class="form-field">
                    <label for="login-password">Password</label>
                    <input type="password" id="login-password" required>
                </div>
                <button type="submit" class="btn">Sign In</button>
                <p id="login-error" class="error-text"></p>
            </form>
            <a href="/" class="back-to-site-link">← Back to Live Site</a>
        </section>

        <div id="admin-dashboard" hidden>

            <header class="admin-header">
                <a href="/" title="Back to Live Site">
                    <img src="/UICsquare.png" alt="Utila Island Cleanups" class="logo">
                </a>
                <div class="admin-header-actions">
                    <a href="/" class="btn btn-secondary">← Back to Live Site</a>
                    <button id="logout-btn" class="btn">Log Out</button>
                </div>
            </header>

            <section class="admin-impact-summary">
                <div class="admin-impact-header">
                    <h2>Our Live Impact</h2>
                    <p class="admin-impact-subtitle">Real-time data from our weekly Wednesday cleanups</p>
                </div>
                <div class="admin-impact-grid">
                    <div class="admin-stat-card">
                        <span class="admin-stat-number" id="admin-stat-bottles">--</span>
                        <span class="admin-stat-label">Plastic Bottles Removed</span>
                    </div>
                    <div class="admin-stat-card">
                        <span class="admin-stat-number" id="admin-stat-weight-kg">--</span>
                        <span class="admin-stat-label">Total Weight (KG)</span>
                    </div>
                    <div class="admin-stat-card">
                        <span class="admin-stat-number" id="admin-stat-weight-lbs">--</span>
                        <span class="admin-stat-label">Total Weight (LBS)</span>
                    </div>
                    <div class="admin-stat-card">
                        <span class="admin-stat-number" id="admin-stat-cleanups">--</span>
                        <span class="admin-stat-label">Successful Cleanups</span>
                    </div>
                </div>
            </section>

            <div class="admin-tabs" role="tablist">
                <button type="button" class="admin-tab active" data-tab="cleanups" role="tab" aria-selected="true">Cleanups &amp; Collections</button>
                <button type="button" class="admin-tab" data-tab="volunteers" role="tab" aria-selected="false">Volunteer Attendance</button>
                <button type="button" class="admin-tab" data-tab="waste" role="tab" aria-selected="false">Waste Breakdown</button>
                <button type="button" class="admin-tab" data-tab="instagram" role="tab" aria-selected="false">Instagram Feed (3 Posts)</button>
            </div>

            <div class="admin-tab-panel" data-panel="cleanups">

                <section class="admin-section">
                    <h2>Log New Cleanup</h2>
                    <form id="cleanup-form">
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="cleanup-date">Date</label>
                                <input type="date" id="cleanup-date" required>
                            </div>
                            <div class="form-field">
                                <label for="cleanup-location">Location</label>
                                <input type="text" id="cleanup-location" required>
                            </div>
                            <div class="form-field">
                                <label for="cleanup-bags">Bags Collected</label>
                                <input type="number" id="cleanup-bags" min="0">
                            </div>
                            <div class="form-field">
                                <label for="cleanup-bottles">Bottles Recycled</label>
                                <input type="number" id="cleanup-bottles" min="0">
                            </div>
                            <div class="form-field">
                                <label for="cleanup-weight">Weight (kg)</label>
                                <input type="number" id="cleanup-weight" min="0" step="0.1">
                            </div>
                            <div class="form-field">
                                <label for="cleanup-volunteers">Volunteers</label>
                                <input type="number" id="cleanup-volunteers" min="0">
                            </div>
                            <div class="form-field">
                                <label for="cleanup-organizer">Lead Organizer</label>
                                <input type="text" id="cleanup-organizer">
                            </div>
                        </div>
                        <div class="form-field">
                            <label for="cleanup-notes">Notes</label>
                            <textarea id="cleanup-notes" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn">Log Cleanup</button>
                        <p id="cleanup-form-status" class="form-status"></p>
                    </form>
                </section>

                <section class="admin-section">
                    <h2>Past Cleanups</h2>
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Location</th>
                                    <th>Bags</th>
                                    <th>Bottles</th>
                                    <th>Weight (kg)</th>
                                    <th>Volunteers</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="cleanups-table-body">
                                <tr><td colspan="7">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>

            <div class="admin-tab-panel" data-panel="volunteers" hidden>

                <section class="admin-section">
                    <h2>Volunteer Attendance</h2>
                    <div class="form-field">
                        <label for="attendance-cleanup-select">Cleanup Event</label>
                        <select id="attendance-cleanup-select">
                            <option value="">Loading cleanups...</option>
                        </select>
                    </div>
                </section>

                <section class="admin-section">
                    <h2>Event Roster</h2>
                    <form id="walkin-form">
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="walkin-name">Name</label>
                                <input type="text" id="walkin-name" required>
                            </div>
                            <div class="form-field">
                                <label for="walkin-email">Email</label>
                                <input type="email" id="walkin-email">
                            </div>
                            <div class="form-field">
                                <label for="walkin-whatsapp">WhatsApp</label>
                                <input type="text" id="walkin-whatsapp">
                            </div>
                        </div>
                        <div class="form-field">
                            <label for="walkin-notes">Notes</label>
                            <input type="text" id="walkin-notes">
                        </div>
                        <button type="submit" class="btn">Add Walk-in</button>
                        <p id="walkin-form-status" class="form-status"></p>
                    </form>
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Contact</th>
                                    <th>Attended</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody id="roster-table-body">
                                <tr><td colspan="4">Select a cleanup above to view its roster.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="admin-section">
                    <h2>Registered Signups</h2>
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>WhatsApp</th>
                                    <th>Language</th>
                                    <th>Planned Date</th>
                                    <th>Gear Needed</th>
                                    <th>Notes</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="signups-table-body">
                                <tr><td colspan="8">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>

            <div class="admin-tab-panel" data-panel="waste" hidden>

                <section class="admin-section">
                    <h2>Waste Breakdown</h2>

                    <div class="checkbox-row">
                        <input type="checkbox" id="waste-auto-sync" checked>
                        <label for="waste-auto-sync">Auto-calculate Kg from Lbs</label>
                    </div>

                    <div class="admin-table-wrap">
                        <table class="admin-table admin-table-editable" id="waste-admin-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Total Weight (Lbs)</th>
                                    <th>Total Weight (Kg)</th>
                                    <th>Total Plastic Bottles Unit</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="waste-admin-table-body">
                                <tr><td colspan="5">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="admin-waste-actions">
                        <button type="button" id="add-waste-row-btn" class="btn btn-secondary">+ Add Category</button>
                        <button type="button" id="save-waste-btn" class="btn">Save Waste Breakdown</button>
                    </div>
                    <p id="waste-form-status" class="form-status"></p>
                </section>

            </div>

            <div class="admin-tab-panel" data-panel="instagram" hidden>

                <section class="admin-section">
                    <h2>Instagram Feed (3 Posts)</h2>
                    <p class="admin-section-hint">Paste up to 3 public Instagram post or reel URLs to feature on the homepage. Tracking parameters (like <code>?igsh=...</code>) are stripped automatically on save.</p>
                    <form id="instagram-form">
                        <div class="form-field">
                            <label for="instagram-slot-1">Post 1 URL</label>
                            <input type="url" id="instagram-slot-1" placeholder="https://www.instagram.com/p/.../">
                        </div>
                        <div class="form-field">
                            <label for="instagram-slot-2">Post 2 URL</label>
                            <input type="url" id="instagram-slot-2" placeholder="https://www.instagram.com/reel/.../">
                        </div>
                        <div class="form-field">
                            <label for="instagram-slot-3">Post 3 URL</label>
                            <input type="url" id="instagram-slot-3" placeholder="https://www.instagram.com/p/.../">
                        </div>
                        <button type="submit" class="btn">Save Instagram Feed</button>
                        <p id="instagram-form-status" class="form-status"></p>
                    </form>
                </section>

            </div>

        </div>

    </div>

    <script>
        import '../scripts/admin.js';
    </script>
</Layout>
