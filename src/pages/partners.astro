---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Our Partners | Utila Island Cleanups">
    <Navbar />

    <header class="about-hero">
        <div class="hero-overlay">
            <h1 data-en="Our Partners & Sponsors" data-es="Nuestros Socios y Patrocinadores" data-fr="Nos partenaires et sponsors">Our Partners & Sponsors</h1>
            <p data-en="Conservation is a team effort. Meet the local businesses and organizations that provide the fuel, tools, and hands for our missions."
               data-es="La conservación es un esfuerzo de equipo. Conozca las empresas y organizaciones locales que proporcionan el combustible, las herramientas y las manos para nuestras misiones." data-fr="La conservation est un effort collectif. Découvrez les entreprises et organisations locales qui fournissent le carburant, les outils et la main-d'œuvre pour nos missions.">
            </p>
        </div>
    </header>

    <section class="partners-grid-section container">
    <div class="partners-detailed-grid">

        <div class="partner-card-large">
            <div class="partner-logo">
                <img src="/logos/OffTheDockLogo.webp" alt="Off the Dock AdventuCares">
            </div>
            <div class="partner-text">
                <h3>Off the Dock AdventuCares</h3>
                <p data-en="The philanthropic arm of Off the Dock Adventures, they provide the essential boat transportation for our North Shore Missions and logistical support for our weekly Wednesday operations."
                   data-es="El brazo filantrópico de Off the Dock Adventures, proporcionan el transporte esencial en bote para nuestras Misiones de la Costa Norte y apoyo logístico." data-fr="Le bras philanthropique d'Off the Dock Adventures, ils assurent le transport en bateau essentiel pour nos Missions de la côte nord et un soutien logistique pour nos opérations hebdomadaires du mercredi.">
                   The philanthropic arm of Off the Dock Adventures, providing essential boat transportation and logistical support.
                </p>
                <a href="https://offthedockadventures.com/" target="_blank" class="partner-link" data-en="Visit Website" data-es="Visitar Sitio Web" data-fr="Visiter le site Web">
                    Visit Website <ion-icon name="arrow-forward-outline"></ion-icon>
                </a>
            </div>
        </div>

        <div class="partner-card-large">
            <div class="partner-logo">
                <img src="/UICsquare.png" alt="Elmer Funes">
            </div>
            <div class="partner-text">
                <h3>Elmer Funes</h3>
                <p data-en="A key local leader in the Utila community, Elmer Funes supports UIC by coordinating local resources and ensuring our efforts align with the needs of the island's residents."
                   data-es="Un líder local clave en la comunidad de Utila, Elmer Funes apoya a UIC coordinando recursos locales." data-fr="Figure locale clé de la communauté d'Utila, Elmer Funes soutient UIC en coordonnant les ressources locales et en veillant à ce que nos efforts répondent aux besoins des habitants de l'île.">
                   A key local leader supporting UIC by coordinating resources and community alignment.
                </p>
            </div>
        </div>

        <div class="partner-card-large">
            <div class="partner-logo">
                <img src="/logos/ReefMatters.webp" alt="Reef Matters">
            </div>
            <div class="partner-text">
                <h3>Reef Matters</h3>
                <p data-en="Focused on marine education and reef health, Reef Matters provides technical expertise and helps us track the impact of land-based pollution on Utila's coral ecosystems."
                   data-es="Enfocado en la educación marina y la salud de los arrecifes, Reef Matters aporta experiencia técnica." data-fr="Axé sur l'éducation marine et la santé des récifs, Reef Matters apporte une expertise technique et nous aide à suivre l'impact de la pollution terrestre sur les écosystèmes coralliens d'Utila.">
                   Provides technical expertise on reef health and the impact of pollution on coral ecosystems.
                </p>
                <a href="https://www.reefmatters.org/" target="_blank" class="partner-link" data-en="Visit Website" data-es="Visitar Sitio Web" data-fr="Visiter le site Web">
                    Visit Website <ion-icon name="arrow-forward-outline"></ion-icon>
                </a>
            </div>
        </div>

        <div class="partner-card-large">
    <div class="partner-logo">
        <img src="/logos/RecycleHonduras.jpg" alt="Recycle Honduras">
    </div>
    <div class="partner-text">
        <h3>Recycle Honduras</h3>
        <p data-en="Our primary processing partner. They ensure that the plastic we collect is transported to the mainland to be recycled, rather than ending up in the island's landfill."
           data-es="Nuestro principal socio de procesamiento. Aseguran que el plástico recolectado se transporte a tierra firme para ser reciclado, en lugar de terminar en el vertedero de la isla." data-fr="Notre partenaire principal de traitement. Ils veillent à ce que le plastique que nous collectons soit transporté vers le continent pour être recyclé, plutôt que de finir dans la décharge de l'île.">
           Ensures collected plastic is transported to the mainland for responsible recycling.
        </p>
        <a href="https://recyclehonduras.com/" target="_blank" class="partner-link" data-en="Visit Website" data-es="Visitar Sitio Web" data-fr="Visiter le site Web">
            Visit Website <ion-icon name="arrow-forward-outline"></ion-icon>
        </a>
    </div>
</div>

    </div>
</section>

    <Footer />
</Layout>
