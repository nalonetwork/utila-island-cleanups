---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Get Involved - Utila Island Cleanups">
    <Fragment slot="head">
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    </Fragment>

    <Navbar />

    <header class="about-hero">
        <div class="hero-overlay">
            <h1 data-en="Get Involved" data-es="Participa" data-fr="Participer">Get Involved</h1>
            <p data-en="Be the change for Utila's coastlines." data-es="Sé el cambio para las costas de Utila." data-fr="Soyez le changement pour le littoral d'Utila.">
                Be the change for Utila's coastlines.
            </p>
        </div>
    </header>

    <main class="container" style="margin-top: 50px; margin-bottom: 50px;">

        <div class="info-grid">
            <div class="info-card">
                <ion-icon name="boat-outline" style="font-size: 3rem; color: #289dd2;"></ion-icon>
                <h2 data-en="Join a Cleanup" data-es="Únete a una Limpieza" data-fr="Rejoindre un nettoyage">Join a Cleanup</h2>
                <p data-en="Every Wednesday at 7:00 AM. No sign-up required—just meet the team at Circle K! We provide transport, water, and materials."
                   data-es="Todos los miércoles a las 7:00 AM. No es necesario registrarse, ¡solo encuéntranos en Circle K! Proporcionamos transporte, agua y materiales." data-fr="Tous les mercredis à 7h00. Aucune inscription nécessaire, retrouvez simplement l'équipe au Circle K ! Nous fournissons le transport, l'eau et le matériel.">
                   Every Wednesday at 7:00 AM. No sign-up required—just meet the team at Circle K! We provide transport, water, and materials.
                </p>
                <a href="/#wednesday-info" class="btn" data-en="View Logistics" data-es="Ver Logística" data-fr="Voir la logistique">View Logistics</a>
            </div>

            <div class="info-card">
                <ion-icon name="hand-left-outline" style="font-size: 3rem; color: #289dd2;"></ion-icon>
                <h2 data-en="Volunteer" data-es="Voluntariado" data-fr="Bénévolat">Volunteer</h2>
                <p data-en="Looking for a deeper commitment? Help us with data collection, social media, or education projects to protect the Swamper iguana."
                   data-es="¿Buscas un compromiso más profundo? Ayúdanos con la recolección de datos, redes sociales o proyectos educativos para proteger la iguana Swamper." data-fr="Vous cherchez un engagement plus profond ? Aidez-nous avec la collecte de données, les réseaux sociaux ou des projets éducatifs pour protéger l'iguane des marais.">
                   Looking for a deeper commitment? Help us with data collection, social media, or education projects to protect the Swamper iguana.
                </p>
                <a href="mailto:utilaislandcleanups@gmail.com" class="btn" data-en="Contact Us" data-es="Contáctanos" data-fr="Contactez-nous">Contact Us</a>
            </div>

            <div class="info-card">
                <ion-icon name="business-outline" style="font-size: 3rem; color: #289dd2;"></ion-icon>
                <h2 data-en="Partner With Us" data-es="Asóciate con Nosotros" data-fr="Devenez partenaire">Partner With Us</h2>
                <p data-en="We work with local businesses like Off the Dock Adventures and Reef Matters. Let's collaborate for a cleaner island."
                   data-es="Trabajamos con negocios locales como Off the Dock Adventures y Reef Matters. Colaboremos por una isla más limpia." data-fr="Nous travaillons avec des entreprises locales comme Off the Dock Adventures et Reef Matters. Collaborons pour une île plus propre.">
                   We work with local businesses like Off the Dock Adventures and Reef Matters. Let's collaborate for a cleaner island.
                </p>
                <a href="/contact" class="btn" data-en="Become a Partner" data-es="Ser un Aliado" data-fr="Devenir partenaire">Become a Partner</a>
            </div>
        </div>

        <div class="volunteer-signup-section">
            <h2 data-en="Sign Up for the Next Cleanup" data-es="Regístrate para la Próxima Limpieza" data-fr="Inscrivez-vous au prochain nettoyage">Sign Up for the Next Cleanup</h2>
            <p data-en="Let us know you're coming so we can plan transport and supplies." data-es="Avísanos que vienes para planear transporte y materiales." data-fr="Faites-nous savoir que vous venez afin que nous puissions prévoir le transport et le matériel.">
                Let us know you're coming so we can plan transport and supplies.
            </p>

            <form id="volunteer-form" class="volunteer-form">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="volunteer-name" data-en="Full Name" data-es="Nombre Completo" data-fr="Nom complet">Full Name</label>
                        <input type="text" id="volunteer-name" name="full_name" required>
                    </div>
                    <div class="form-field">
                        <label for="volunteer-email" data-en="Email" data-es="Correo Electrónico" data-fr="E-mail">Email</label>
                        <input type="email" id="volunteer-email" name="email" required>
                    </div>
                    <div class="form-field">
                        <label for="volunteer-whatsapp" data-en="WhatsApp Number" data-es="Número de WhatsApp" data-fr="Numéro WhatsApp">WhatsApp Number</label>
                        <input type="tel" id="volunteer-whatsapp" name="whatsapp_number">
                    </div>
                    <div class="form-field">
                        <label for="volunteer-language" data-en="Preferred Language" data-es="Idioma Preferido" data-fr="Langue préférée">Preferred Language</label>
                        <select id="volunteer-language" name="preferred_language">
                            <option value="en">English</option>
                            <option value="es">Español</option>
                            <option value="fr">Français</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="volunteer-date" data-en="Planned Date" data-es="Fecha Planeada" data-fr="Date prévue">Planned Date</label>
                        <input type="date" id="volunteer-date" name="planned_date">
                    </div>
                    <div class="form-field checkbox-field">
                        <label for="volunteer-gloves">
                            <input type="checkbox" id="volunteer-gloves" name="has_own_gloves">
                            <span data-en="I have my own gloves" data-es="Tengo mis propios guantes" data-fr="J'ai mes propres gants">I have my own gloves</span>
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label for="volunteer-notes" data-en="Notes" data-es="Notas" data-fr="Remarques">Notes</label>
                    <textarea id="volunteer-notes" name="notes" rows="3"></textarea>
                </div>
                <button type="submit" class="btn" data-en="Sign Up" data-es="Registrarse" data-fr="S'inscrire">Sign Up</button>
                <p id="volunteer-form-status" class="form-status" role="status"></p>
            </form>
        </div>

    </main>

    <Footer />

    <script>
        import '../scripts/volunteer-form.js';
    </script>
</Layout>
