---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Get Involved - Utila Island Cleanups">
    <Fragment slot="head">
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    </Fragment>

    <Navbar />

    <header class="about-hero">
        <div class="hero-overlay">
            <h1 data-en="GET INVOLVED" data-es="PARTICIPA" data-fr="PARTICIPER">GET INVOLVED</h1>
            <p data-en="Help comes in many forms" data-es="La ayuda llega de muchas formas" data-fr="L'aide prend plusieurs formes">
                Help comes in many forms
            </p>
        </div>
    </header>

    <main class="container" style="margin-top: 50px; margin-bottom: 50px;">

        <div class="info-grid">
            <div class="info-card">
                <ion-icon name="boat-outline" style="font-size: 3rem; color: #289dd2;"></ion-icon>
                <h2 data-en="Join a Cleanup" data-es="Únete a una Limpieza" data-fr="Rejoindre un nettoyage">Join a Cleanup</h2>
                <p data-en="Every Wednesday at 7:00 AM. No sign-up required—just meet the team at Circle K! We provide transport, water, and materials."
                   data-es="Todos los miércoles a las 7:00 AM. No es necesario registrarse, ¡solo encuéntranos en Circle K! Proporcionamos transporte, agua y materiales." data-fr="Tous les mercredis à 7h00. Aucune inscription nécessaire, retrouvez simplement l'équipe au Circle K ! Nous fournissons le transport, l'eau et le matériel.">
                   Every Wednesday at 7:00 AM. No sign-up required—just meet the team at Circle K! We provide transport, water, and materials.
                </p>
            </div>

            <div class="info-card">
                <ion-icon name="cash-outline" style="font-size: 3rem; color: #289dd2;"></ion-icon>
                <h2 data-en="Donate" data-es="Dona" data-fr="Faire un don">Donate</h2>
                <p data-en="Support our ongoing cleanup efforts by making a monetary contribution to help us cover logistical and operational costs."
                   data-es="Apoya nuestros esfuerzos continuos de limpieza haciendo una contribución monetaria para ayudarnos a cubrir los costos logísticos y operativos." data-fr="Soutenez nos efforts de nettoyage continus en faisant une contribution financière pour nous aider à couvrir les coûts logistiques et opérationnels.">
                   Support our ongoing cleanup efforts by making a monetary contribution to help us cover logistical and operational costs.
                </p>
                <a href="https://utila-island-cleanups-lyart.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn" data-en="Donate Now" data-es="Donar Ahora" data-fr="Faire un don maintenant">Donate Now</a>
            </div>

            <div class="info-card">
                <ion-icon name="business-outline" style="font-size: 3rem; color: #289dd2;"></ion-icon>
                <h2 data-en="Become a Partner or Sponsor" data-es="Conviértete en Socio o Patrocinador" data-fr="Devenir partenaire ou sponsor">Become a Partner or Sponsor</h2>
                <p data-en="Help comes in many forms. Donate materials, sponsor a specific project, or collaborate with us."
                   data-es="La ayuda llega de muchas formas. Dona materiales, patrocina un proyecto específico o colabora con nosotros." data-fr="L'aide prend plusieurs formes. Faites don de matériel, parrainez un projet spécifique ou collaborez avec nous.">
                   Help comes in many forms. Donate materials, sponsor a specific project, or collaborate with us.
                </p>
                <a href="mailto:info@utilaislandcleanups.org" class="btn" data-en="Get in Touch" data-es="Ponte en Contacto" data-fr="Prenez contact">Get in Touch</a>
            </div>
        </div>

    </main>

    <Footer />
</Layout>
