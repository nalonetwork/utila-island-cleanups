---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Layout
    title="Our Impact - Utila Island Cleanups"
    description="Utila Island Cleanups is a community-led non-profit dedicated to beach cleanups and protecting marine life in Utila, Honduras. Join us every Wednesday morning."
    keywords="Utila, Honduras, beach cleanup, marine conservation, Swamper iguana, sea turtles, environmental awareness, Off the Dock Adventures"
    ogTitle="Utila Island Cleanups | Creating Awareness One Cleanup at a Time"
    ogDescription="Weekly beach cleanups in Utila, Honduras to preserve vital coastal ecosystems."
>
    <Navbar />

    <header class="about-hero">
        <h1 data-en="Our Measurable Impact" data-es="Nuestro Impacto Medible" data-fr="Notre impact mesurable">Our Measurable Impact</h1>
    </header>

    <main class="container">


        <section class="impact-hero-stats">
    <div class="container">
        <div class="impact-header">
            <h2 data-en="Our Live Impact" data-es="Nuestro Impacto en Vivo" data-fr="Notre impact en direct">Our Live Impact</h2>
            <p class="update-tag" data-en="Real-time data from our weekly Wednesday cleanups" data-es="Datos en tiempo real de nuestras limpiezas de los miércoles" data-fr="Données en temps réel de nos nettoyages hebdomadaires du mercredi">
                Real-time data from our weekly Wednesday cleanups
            </p>
        </div>

        <div class="stats-glass-grid">
            <div class="glass-card">
                <div class="icon-box bottle-bg">
                    <ion-icon name="wine-outline"></ion-icon>
                </div>
                <div class="stat-content">
                    <h3 class="counter" id="count-bottles" data-target="13318">13318</h3>
                    <p data-en="Plastic Bottles Removed" data-es="Botellas de Plástico Retiradas" data-fr="Bouteilles en plastique retirées">Plastic Bottles Removed</p>
                </div>
            </div>

            <div class="glass-card">
                <div class="icon-box weight-bg">
                    <ion-icon name="scale-outline"></ion-icon>
                </div>
                <div class="stat-content">
                    <h3 class="counter" id="count-weight-kg" data-target="2240.4">2240.4</h3>
                    <p data-en="Total Weight (KG)" data-es="Peso Total (KG)" data-fr="Poids total (KG)">Total Weight (KG)</p>
                </div>
            </div>

            <div class="glass-card">
                <div class="icon-box weight-lbs-bg">
                    <ion-icon name="fitness-outline"></ion-icon>
                </div>
                <div class="stat-content">
                    <h3 class="counter" id="count-weight-lbs" data-target="4939.3">4939.3</h3>
                    <p data-en="Total Weight (LBS)" data-es="Peso Total (LBS)" data-fr="Poids total (LBS)">Total Weight (LBS)</p>
                </div>
            </div>

            <div class="glass-card">
                <div class="icon-box cleanup-bg">
                    <ion-icon name="calendar-number-outline"></ion-icon>
                </div>
                <div class="stat-content">
                    <h3 class="counter" id="count-cleanups" data-target="17">17</h3>
                    <p data-en="Successful Cleanups" data-es="Limpiezas Exitosas" data-fr="Nettoyages réussis">Successful Cleanups</p>
                </div>
            </div>
        </div>
    </div>
</section>

    </main>

    <Footer />

    <script>
        import '../scripts/live-counters.js';
    </script>
</Layout>
